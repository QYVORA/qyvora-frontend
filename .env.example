# In dev: Vite proxies /api → http://localhost:3000 (see vite.config.ts)
# In production: the permanent API host — set the SAME value as the Netlify
#   project environment variable `VITE_API_BASE_URL`:
#     https://api.qyvora.org/api
#   (api.qyvora.org → CNAME qyvora-backend.onrender.com; verified serving JSON
#    with CORS for https://qyvora.org on 2026-10-19)
# Do NOT use https://qyvora.org/api — netlify.toml has no /api proxy, so that
#   path returns index.html instead of JSON and every API call silently fails.
VITE_API_BASE_URL=/api
VITE_CHAIN_API_BASE_URL=http://localhost:4100

# ── Bootcamp WhatsApp group invites ───────────────────────────────────────────
# Defaults live in src/features/marketing/content/bootcampData.ts
# (BOOTCAMP_WHATSAPP_URLS). Set a variable here to override a link without a
# code change — used by the bootcamp access modal and the join CTAs.
# VITE_BOOTCAMP_WHATSAPP_URL=https://chat.whatsapp.com/your-invite
# VITE_HPB_WHATSAPP_URL=https://chat.whatsapp.com/your-invite
# VITE_QOSE_WHATSAPP_URL=https://chat.whatsapp.com/your-invite

# ── PWA / service worker ──────────────────────────────────────────────────────
# The service worker only registers in production builds (it would otherwise
# cache Vite's dev module graph and break HMR). Set to true to exercise the
# install prompt and offline behaviour on localhost.
# VITE_ENABLE_SW_IN_DEV=true
